# Copy this file to .env and fill in your own values.

# Postgres via Supabase (Project → Connect → ORM: Prisma gives you both lines).
# DATABASE_URL is the pooled connection (app runtime). DIRECT_URL bypasses the
# pooler and is required for `prisma migrate` / `prisma db push` — the pooler
# can't hold the session-level advisory lock those need.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Any random string works; used to sign session cookies.
SESSION_SECRET=""

# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Optional: protects /api/cron/check-reminders in production.
CRON_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Whop — current checkout provider, embedded directly on /suscripcion.
# Account API Key: Whop dashboard → Developer → API Keys.
WHOP_API_KEY=""
# Public, safe to expose client-side: the $8/mo plan's ID (prefixed `plan_`).
NEXT_PUBLIC_WHOP_PLAN_ID=""
# Signing secret from the webhook created for /api/webhooks/whop
# (Whop dashboard → Developer → Webhooks). Verifies payment/membership events.
WHOP_WEBHOOK_SECRET=""

# Legacy Mercado Pago — no longer used for new checkouts, kept only so
# subscribers who signed up before the Whop switch can still be canceled.
MERCADOPAGO_SUBSCRIPTION_LINK=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_SUBSCRIPTION_PRICE_ARS=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Legacy Stripe — no longer used for new checkouts, kept only so subscribers
# who signed up before the Mercado Pago switch can still be canceled/tracked.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Get a key at https://resend.com — used for account-verification and
# password-reset emails. Without it those emails fail to send.
RESEND_API_KEY=""
# Must be a verified domain in Resend, or the shared sandbox address below
# (which only works for testing, not real users).
EMAIL_FROM="Operaciones <onboarding@resend.dev>"
