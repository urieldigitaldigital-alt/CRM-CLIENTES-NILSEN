# Copy this file to .env and fill in your own values.

# Postgres via Supabase (Project → Connect → ORM: Prisma gives you both lines).
# DATABASE_URL is the pooled connection (app runtime). DIRECT_URL bypasses the
# pooler and is required for `prisma migrate` / `prisma db push` — the pooler
# can't hold the session-level advisory lock those need.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Any random string works; used to sign session cookies.
SESSION_SECRET=""

# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Optional: protects /api/cron/check-reminders in production.
CRON_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago — checkout URL for a "Plan de suscripción" created in the
# seller dashboard (Herramientas de ventas → Planes de suscripción). Used
# directly for the "Suscribirme" button; no Access Token needed for this flow.
MERCADOPAGO_SUBSCRIPTION_LINK=""

# Below: for the API-based checkout (src/lib/mercadopago.ts), not currently
# wired up in src/actions/billing.ts — switch to it once you have an Access
# Token (lets the app auto-activate accounts via webhook instead of manually).
# Get an access token at https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Monthly subscription price in ARS (whole pesos, e.g. "9000").
MERCADOPAGO_SUBSCRIPTION_PRICE_ARS=""
# Optional but recommended: "Clave secreta" from the app's Webhooks config in
# the Mercado Pago dev panel. Verifies that webhook calls really came from MP.
MERCADOPAGO_WEBHOOK_SECRET=""

# Legacy Stripe — no longer used for new checkouts, kept only so subscribers
# who signed up before the Mercado Pago switch can still be canceled/tracked.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Get a key at https://resend.com — used for account-verification and
# password-reset emails. Without it those emails fail to send.
RESEND_API_KEY=""
# Must be a verified domain in Resend, or the shared sandbox address below
# (which only works for testing, not real users).
EMAIL_FROM="Operaciones <onboarding@resend.dev>"
